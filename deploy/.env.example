# Environment for deploy/compose.yaml. Copy to deploy/.env, fill in, then:
#   chmod 600 deploy/.env
# deploy/.env is ignored by git. Never commit it.
#
# Generate every secret with:
#   openssl rand -hex 32
# Use hex values for passwords: they go into postgresql:// URLs unescaped.
#
# Keep the whole file (encrypted) outside this host as well; see README
# "Backups". SECRET_KEY in particular must also be in the team password
# manager.

# ---------------------------------------------------------------------------
# Host names and TLS
# ---------------------------------------------------------------------------
# Cloudflare A records, DNS only (grey cloud), pointing at the static IP.
DOCS_HOST=docs.southeastexpeditionmed.com
MCP_HOST=docs-mcp.southeastexpeditionmed.com
# Address Let's Encrypt uses for expiry notices.
ACME_EMAIL=

# ---------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------
# Docmost release tag on Docker Hub (docmost/docmost), without the leading "v"
# of the GitHub release name. Never "latest". Pick the newest release from
# https://github.com/docmost/docmost/releases and confirm the tag exists at
# https://hub.docker.com/r/docmost/docmost/tags. At least 0.97.0.
DOCMOST_TAG=0.97.0

# Our build of osh-labs/docmost-mcp-remote, by digest. Required, no default:
#   MCP_IMAGE=ghcr.io/osh-labs/docmost-mcp-remote@sha256:<64 hex characters>
# Get the digest from the fork's GitHub Actions run or with:
#   docker buildx imagetools inspect ghcr.io/osh-labs/docmost-mcp-remote:<tag>
MCP_IMAGE=

# Optional overrides (defaults shown). Caddy needs 2.10 or later for the
# multi_regexp log filter used in the Caddyfile.
# CADDY_TAG=2.11
# POSTGRES_TAG=18
# REDIS_TAG=8

# ---------------------------------------------------------------------------
# Postgres (one server, two databases)
# ---------------------------------------------------------------------------
# Password of the "docmost" role (owner of the docmost database, superuser).
POSTGRES_PASSWORD=
# Password of the "docmost_mcp" role (owner of the docmost_mcp database).
# Used by postgres-init/10-mcp.sh on the FIRST start of an empty volume only.
# Changing it later needs ALTER ROLE; see README "Changing database passwords".
MCP_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Docmost
# ---------------------------------------------------------------------------
# Signs Docmost sessions. Changing it signs every Docmost user out.
APP_SECRET=
# Docmost login session lifetime (Docmost default 90d).
# JWT_TOKEN_EXPIRES_IN=90d
# Upload limits (Docmost defaults). If raised, raise the docs site
# request_body max_size in the Caddyfile too.
# FILE_UPLOAD_SIZE_LIMIT=50mb
# FILE_IMPORT_SIZE_LIMIT=200mb
# Anonymous usage telemetry to Docmost. Kept off (decision 2026-11-09).
DISABLE_TELEMETRY=true
# Postgres pool size for Docmost (Docmost default 10).
# DOCMOST_DATABASE_MAX_POOL=10
# Node options. Keep --no-webstorage (the image default). To cap the heap on
# a 1 GB host (not validated; see build plan 5.3):
# DOCMOST_NODE_OPTIONS=--no-webstorage --max-old-space-size=384

# Mail: deferred until the installation is running (decision 2026-11-09).
# With MAIL_DRIVER=log, Docmost discards all mail: copy invitation links
# from Settings > Members by hand.
MAIL_DRIVER=log
#
# Later, Migadu: create a mailbox such as docs@southeastexpeditionmed.com;
# MAIL_FROM_ADDRESS must be that mailbox or one of its identities and
# SMTP_USERNAME the full address. Port 465 is implicit TLS
# (SMTP_SECURE=true); 587 is STARTTLS (SMTP_SECURE=false).
# MAIL_DRIVER=smtp
# MAIL_FROM_ADDRESS=docs@southeastexpeditionmed.com
# MAIL_FROM_NAME=SEM Docs
# SMTP_HOST=smtp.migadu.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USERNAME=docs@southeastexpeditionmed.com
# SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# MCP sidecar (docmost-mcp-remote)
# ---------------------------------------------------------------------------
# Encrypts stored Docmost sessions and page snapshots and signs cookies.
# At least 32 characters. Keep a copy in the team password manager: losing
# it signs every member out of the connector and makes stored snapshots
# unreadable. Leaking it together with a database dump exposes members'
# Docmost sessions.
SECRET_KEY=
# Only during a key rotation (see README "Rotating SECRET_KEY").
SECRET_KEY_PREVIOUS=

# Comma-separated, no spaces. Empty allows every Docmost user to sign in to
# the connector. Set it to the team list.
ALLOWED_EMAILS=
# Comma-separated space slugs or ids usable through MCP. Empty allows every
# space the member can see in Docmost.
ALLOWED_SPACES=

# "ask": members sign in again when their Docmost session expires.
RELOGIN_MODE=ask
# OAuth redirect URIs allowed for registered clients (loopback for Claude
# Code is always allowed). Requires the osh-labs fork with patch P-2; see
# docs/mcp/SECURITY_REVIEW.md.
OAUTH_REDIRECT_ALLOWLIST=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
TOOL_CALLS_PER_MINUTE=60
MAX_PAGE_CHARS=60000
SNAPSHOT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
# UPLOAD_RETENTION_MINUTES=60
# MCP_LOG_LEVEL=info
#
# Fixed in compose.yaml, not set here:
#   PUBLIC_URL=https://$MCP_HOST, DOCMOST_URL=http://docmost:3000,
#   DOCMOST_ALLOW_INSECURE_HTTP=true, UPLOAD_MAX_MB=50 (matches the Caddyfile),
#   FORWARDED_ALLOW_IPS=172.28.10.0/24 (the "proxy" network Caddy is on).

# ---------------------------------------------------------------------------
# Backups (scripts/backup.sh and scripts/restore.sh only; Compose ignores these)
# ---------------------------------------------------------------------------
# Destination, without a trailing slash. Objects are written under
#   s3://$BACKUP_S3_BUCKET/$BACKUP_S3_PREFIX/YYYY/MM/DD/<UTC timestamp>/
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=sem-docmost
# IAM user limited to s3:PutObject and s3:GetObject on that bucket. Leave
# these empty to use the host's AWS CLI profile or instance role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Optional: S3 storage class for uploads (STANDARD, STANDARD_IA, ...).
BACKUP_S3_STORAGE_CLASS=STANDARD
# Local copies kept under BACKUP_DIR for this many days.
BACKUP_DIR=/var/backups/sem-docmost
BACKUP_LOCAL_RETENTION_DAYS=7
# Optional: also upload this .env file encrypted with age to a separate
# destination (build plan 6.2). Both must be set, and "age" installed.
#   BACKUP_AGE_RECIPIENT=age1...
#   BACKUP_ENV_S3_URI=s3://other-bucket/sem-docmost-env
BACKUP_AGE_RECIPIENT=
BACKUP_ENV_S3_URI=
